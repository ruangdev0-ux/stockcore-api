# Variáveis usadas pela API. Copie para .env (que não vai para o Git) ou use dotnet user-secrets.
# O ASP.NET Core lê variáveis de ambiente com "__" no lugar de ":" (Jwt__Key = Jwt:Key).

ASPNETCORE_ENVIRONMENT=Development

# Banco local do docker-compose.yml (credenciais só de desenvolvimento)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=stockcore;Username=stockcore;Password=stockcore

# Chave de assinatura do JWT: obrigatória, com pelo menos 32 caracteres.
# Gere uma com: openssl rand -base64 48
Jwt__Key=
Jwt__Issuer=StockCore.Api
Jwt__Audience=StockCore.Client
Jwt__ExpirationMinutes=60

# Aplica as migrations e o seed fictício ao iniciar (útil só em desenvolvimento)
Database__ApplyMigrationsOnStartup=true
Database__Seed=true

# Usada só pelos testes de integração (banco separado)
TEST_CONNECTION_STRING=Host=localhost;Port=5432;Database=stockcore_test;Username=stockcore;Password=stockcore
